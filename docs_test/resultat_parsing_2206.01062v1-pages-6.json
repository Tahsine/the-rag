                    {
                        "level": 3,
                        "md": "### Baselines for Object Detection",
                        "value": "Baselines for Object Detection",
                        "bbox": [
                            {
                                "h": 17.5,
                                "w": 149.61,
                                "x": 317.46,
                                "y": 489.33,
                                "confidence": 1.0,
